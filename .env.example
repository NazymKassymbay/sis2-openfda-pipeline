# Copy to .env and adjust if needed:  cp .env.example .env
# openFDA works without a key (240 requests/min, 1000/day per IP).
# A free key raises the daily limit: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
OPENFDA_DATE_FROM=20240101
OPENFDA_DATE_TO=20241231
TARGET_RECORDS=600
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=drug-adverse-events
SAMPLE_DAYS=1,7,13,19,25
